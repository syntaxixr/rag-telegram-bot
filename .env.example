# Любой OpenAI-совместимый API: DeepSeek, GLM (open.bigmodel.cn), Qwen, OpenRouter,
# локальная модель через Ollama (http://localhost:11434/v1) или vLLM.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Папка с документами (.md, .txt, .pdf)
DOCS_DIR=docs

# Сколько фрагментов отдавать модели и порог, ниже которого в модель не ходим
TOP_K=4
MIN_SCORE=1.5

# Цена за 1M токенов для отчёта (необязательно)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
